# Environment Variables Configuration
# Copy this file to .env and fill in your values
# ⚠️  SECURITY WARNING: Never commit real credentials to version control!

# Application
NODE_ENV=development
PORT=7171

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ⚠️  SECURITY: Replace placeholders with actual values in .env only
DATABASE_URL="postgresql://user:password@localhost:5432/diix"

# Session Secret (REQUIRED IN PRODUCTION!)
# Generate a random string: openssl rand -base64 32
# ⚠️  SECURITY: Must be at least 32 characters, unique per environment
# ⚠️  SECURITY: Application will fail to start in production if not set properly
SESSION_SECRET="<generate-random-secret-min-32-chars>"

# Master User Credentials
# ⚠️  SECURITY: Change default passwords immediately in production
# ⚠️  SECURITY: Application will fail to start in production if using default value
MASTER_USERNAME="dixavado"
MASTER_PASSWORD="<change-default-password>"
MASTER_EMAIL="admin@diixsolutions.local"

# Redis (for session store in production)
# ⚠️  SECURITY: Use authenticated Redis in production
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL=info

# ============================================================================
# PRODUCTION SETTINGS - UNCOMMENT AND CONFIGURE IN PRODUCTION
# ============================================================================
# NODE_ENV=production
# SESSION_SECRET=<generate-strong-random-secret-using-openssl-rand-base64-32>
# MASTER_PASSWORD=<use-strong-password-min-12-chars-with-special-chars>
# LOG_LEVEL=warn
# REDIS_URL=redis://:<password>@<redis-host>:6379
# DATABASE_URL=postgresql://<user>:<strong-password>@<db-host>:5432/<database>
