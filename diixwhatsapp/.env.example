# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=7171

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# SECURITY: Never commit real credentials to version control
DATABASE_URL="postgresql://user:password@localhost:5432/diix"

# Session Secret (REQUIRED IN PRODUCTION!)
# Generate a random string: openssl rand -base64 32
# SECURITY: Must be at least 32 characters, unique per environment
SESSION_SECRET="<generate-random-secret-min-32-chars>"

# Master User Credentials
# SECURITY: Change default passwords immediately in production
MASTER_USERNAME="dixavado"
MASTER_PASSWORD="<change-default-password>"
MASTER_EMAIL="admin@diixsolutions.local"

# Logging
LOG_LEVEL=info

# Production Settings (uncomment in production)
# NODE_ENV=production
# SESSION_SECRET=<generate-strong-random-secret>
# MASTER_PASSWORD=<use-strong-password>
# LOG_LEVEL=warn
