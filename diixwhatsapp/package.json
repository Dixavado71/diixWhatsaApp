{
  "name": "diixwhatsapp",
  "version": "1.0.0",
  "description": "DiixWhatsApp - Sistema administrativo multi-tenant para gestão de lojas",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test",
    "test:watch": "nodemon --exec \"node --test\" tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:isolation": "node --test tests/isolation.test.js"
  },
  "keywords": [
    "multi-tenant",
    "whatsapp",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Dixavado",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
