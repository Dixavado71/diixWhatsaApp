<%
  const showSidebar = true;
  const currentPage = 'dashboard';
  const title = 'Dashboard Admin';
%>

<%- include('../layouts/main', {
  showSidebar: showSidebar,
  currentPage: currentPage,
  title: title,
  user: user
}) %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-storefront text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalTenants %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Lojas</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-green-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-check-circle text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.activeTenants %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Lojas Ativas</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-pause-circle text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.inactiveTenants %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Lojas Inativas</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-violet-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-users text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalUsers %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Usuários</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-pink-500 to-rose-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-package text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalProducts %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Produtos</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-blue-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-users-three text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalClients %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Clientes</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-cyan-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-briefcase text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalServices %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Serviços</p>
  </div>
  
  <div class="card-hover glass dark:glass-dark rounded-2xl p-6 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-gradient-to-br from-yellow-500 to-amber-600 rounded-xl flex items-center justify-center shadow-glow">
        <i class="ph ph-tag text-white text-2xl"></i>
      </div>
      <span class="text-3xl font-bold text-gray-900 dark:text-white"><%= stats.totalPromotions %></span>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 font-medium">Total de Promoções</p>
  </div>
</div>

<div class="glass dark:glass-dark rounded-2xl shadow-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Lojas Recentes</h2>
    <a href="/admin/tenants/new" class="btn-glow px-4 py-2 bg-diix-gradient text-white rounded-xl font-medium hover:bg-diix-gradient-hover transition-all duration-300 shadow-md hover:shadow-glow">
      <i class="ph ph-plus-circle mr-2"></i>Nova Loja
    </a>
  </div>
  <div class="p-6">
    <% if (tenants && tenants.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="table-premium w-full">
          <thead>
            <tr class="text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
              <th class="pb-3">Loja</th>
              <th class="pb-3">Slug</th>
              <th class="pb-3">Status</th>
              <th class="pb-3">Usuários</th>
              <th class="pb-3">Produtos</th>
              <th class="pb-3">Clientes</th>
              <th class="pb-3">Criada em</th>
              <th class="pb-3">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% tenants.forEach(tenant => { %>
              <tr class="transition-all duration-200">
                <td class="py-3"><strong class="text-gray-900 dark:text-white"><%= tenant.name %></strong></td>
                <td class="py-3"><code class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-xs text-primary-600 dark:text-primary-400"><%= tenant.slug %></code></td>
                <td class="py-3">
                  <% if (tenant.active) { %>
                    <span class="badge px-3 py-1 bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300 rounded-full text-xs font-semibold">
                      <i class="ph ph-check-circle mr-1"></i>Ativa
                    </span>
                  <% } else { %>
                    <span class="badge px-3 py-1 bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300 rounded-full text-xs font-semibold">
                      <i class="ph ph-pause-circle mr-1"></i>Inativa
                    </span>
                  <% } %>
                </td>
                <td class="py-3 text-gray-600 dark:text-gray-400"><%= tenant._count.users || 0 %></td>
                <td class="py-3 text-gray-600 dark:text-gray-400"><%= tenant._count.products || 0 %></td>
                <td class="py-3 text-gray-600 dark:text-gray-400"><%= tenant._count.clients || 0 %></td>
                <td class="py-3 text-gray-600 dark:text-gray-400"><%= new Date(tenant.createdAt).toLocaleDateString('pt-BR') %></td>
                <td class="py-3">
                  <div class="flex items-center space-x-2">
                    <a href="/admin/tenants/<%= tenant.id %>" class="p-2 bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors" title="Ver">
                      <i class="ph ph-eye"></i>
                    </a>
                    <a href="/admin/tenants/<%= tenant.id %>/edit" class="p-2 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors" title="Editar">
                      <i class="ph ph-pencil-simple"></i>
                    </a>
                    <form action="/admin/tenants/<%= tenant.id %>/toggle" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="p-2 <%= tenant.active ? 'bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-300 hover:bg-amber-200 dark:hover:bg-amber-800' : 'bg-emerald-100 dark:bg-emerald-900 text-emerald-600 dark:text-emerald-300 hover:bg-emerald-200 dark:hover:bg-emerald-800' %> rounded-lg transition-colors" title="<%= tenant.active ? 'Desativar' : 'Ativar' %>">
                        <i class="ph ph-<%= tenant.active ? 'pause' : 'play' %>"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-12">
        <i class="ph ph-storefront text-6xl text-gray-300 dark:text-gray-600 mb-4"></i>
        <p class="text-gray-500 dark:text-gray-400 text-lg">Nenhuma loja cadastrada.</p>
        <a href="/admin/tenants/new" class="mt-4 inline-block px-6 py-2 bg-diix-gradient text-white rounded-xl font-medium hover:bg-diix-gradient-hover transition-all duration-300">
          <i class="ph ph-plus-circle mr-2"></i>Criar Primeira Loja
        </a>
      </div>
    <% } %>
  </div>
</div>
