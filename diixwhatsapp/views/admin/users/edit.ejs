<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head', { title: 'Editar Usuário' }) %>
</head>
<body class="admin-user-form">
  <%- include('../../partials/navbar', { user: user, area: 'admin' }) %>
  
  <div class="container-fluid">
    <div class="row">
      <%- include('../../partials/sidebar', { area: 'admin' }) %>
      
      <main class="col-md-10 ms-sm-auto col-lg-12 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2">Editar Usuário</h1>
          <a href="/admin/users" class="btn btn-secondary">Voltar</a>
        </div>
        
        <%- include('../../partials/flash') %>
        
        <div class="card">
          <div class="card-body">
            <form action="/admin/users/<%= userToEdit.id %>/edit" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="username" class="form-label">Username *</label>
                  <input type="text" class="form-control" id="username" name="username" value="<%= userToEdit.username %>" required>
                </div>
                
                <div class="col-md-6 mb-3">
                  <label for="name" class="form-label">Nome Completo</label>
                  <input type="text" class="form-control" id="name" name="name" value="<%= userToEdit.name || '' %>">
                </div>
              </div>
              
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" value="<%= userToEdit.email || '' %>">
              </div>
              
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="password" class="form-label">Nova Senha (deixe em branco para manter)</label>
                  <input type="password" class="form-control" id="password" name="password" minlength="6">
                  <small class="text-muted">Preencha apenas se desejar alterar a senha</small>
                </div>
                
                <div class="col-md-6 mb-3">
                  <label for="role" class="form-label">Role *</label>
                  <select class="form-select" id="role" name="role" required <%= userToEdit.role === 'MASTER' ? 'disabled' : '' %>>
                    <option value="TENANT_USER" <%= userToEdit.role === 'TENANT_USER' ? 'selected' : '' %>>TENANT_USER</option>
                    <option value="TENANT_ADMIN" <%= userToEdit.role === 'TENANT_ADMIN' ? 'selected' : '' %>>TENANT_ADMIN</option>
                    <% if (user.role === 'MASTER') { %>
                      <option value="MASTER" <%= userToEdit.role === 'MASTER' ? 'selected' : '' %>>MASTER</option>
                    <% } %>
                  </select>
                  <% if (userToEdit.role === 'MASTER') { %>
                    <input type="hidden" name="role" value="<%= userToEdit.role %>">
                  <% } %>
                </div>
              </div>
              
              <div class="mb-3">
                <label for="tenantId" class="form-label">Loja</label>
                <select class="form-select" id="tenantId" name="tenantId">
                  <option value="">-- Sem Loja --</option>
                  <% tenants.forEach(tenant => { %>
                    <option value="<%= tenant.id %>" <%= userToEdit.tenantId === tenant.id ? 'selected' : '' %>><%= tenant.name %></option>
                  <% }) %>
                </select>
              </div>
              
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="active" name="active" value="true" <%= userToEdit.active ? 'checked' : '' %>>
                <label class="form-check-label" for="active">
                  Usuário Ativo
                </label>
              </div>
              
              <div class="mt-4">
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                <a href="/admin/users" class="btn btn-secondary">Cancelar</a>
              </div>
            </form>
            
            <% if (userToEdit.role !== 'MASTER') { %>
            <hr class="my-4">
            
            <div class="alert alert-danger">
              <h5 class="alert-heading">Zona de Perigo</h5>
              <p>Excluir um usuário é uma ação permanente e não pode ser desfeita.</p>
              <form action="/admin/users/<%= userToEdit.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este usuário?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger">Excluir Usuário</button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>
  
  <%- include('../../partials/footer') %>
</body>
</html>
