<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head', { title: 'Listar Lojas' }) %>
</head>
<body class="admin-tenants">
  <%- include('../../partials/navbar', { user: user, area: 'admin' }) %>
  
  <div class="container-fluid">
    <div class="row">
      <%- include('../../partials/sidebar', { area: 'admin' }) %>
      
      <main class="col-md-10 ms-sm-auto col-lg-12 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2">Gerenciar Lojas</h1>
          <a href="/admin/tenants/new" class="btn btn-primary">Nova Loja</a>
        </div>
        
        <%- include('../../partials/flash') %>
        
        <div class="card">
          <div class="card-body">
            <% if (tenants && tenants.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Nome</th>
                      <th>Slug</th>
                      <th>Email</th>
                      <th>Status</th>
                      <th>Criada em</th>
                      <th>Ações</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% tenants.forEach(tenant => { %>
                      <tr>
                        <td><strong><%= tenant.name %></strong></td>
                        <td><code><%= tenant.slug %></code></td>
                        <td><%= tenant.email || '-' %></td>
                        <td>
                          <% if (tenant.active) { %>
                            <span class="badge bg-success">Ativa</span>
                          <% } else { %>
                            <span class="badge bg-danger">Inativa</span>
                          <% } %>
                        </td>
                        <td><%= new Date(tenant.createdAt).toLocaleDateString('pt-BR') %></td>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <a href="/admin/tenants/<%= tenant.id %>" class="btn btn-outline-primary">Ver</a>
                            <a href="/admin/tenants/<%= tenant.id %>/edit" class="btn btn-outline-secondary">Editar</a>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="text-muted text-center">Nenhuma loja cadastrada.</p>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>
  
  <%- include('../../partials/footer') %>
</body>
</html>
