<%- include('../partials/head', { title: title }) %>

<div class="dashboard-container">
  <div class="page-header">
    <h1><i class="icon-clients"></i> Clientes</h1>
    <a href="/tenant/clients/new" class="btn btn-primary">
      <i class="icon-plus"></i> Novo Cliente
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (clients.length === 0) { %>
    <div class="empty-state">
      <i class="icon-inbox"></i>
      <p>Nenhum cliente cadastrado</p>
      <a href="/tenant/clients/new" class="btn btn-secondary">Cadastrar primeiro cliente</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% clients.forEach(client => { %>
            <tr>
              <td>
                <strong><%= client.name %></strong>
                <% if (client.document) { %>
                  <br><small class="text-muted"><%= client.document %></small>
                <% } %>
              </td>
              <td>
                <% if (client.email) { %>
                  <a href="mailto:<%= client.email %>"><%= client.email %></a>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td><%= client.phone || '-' %></td>
              <td><%= client.city || '-' %></td>
              <td>
                <% if (client.active) { %>
                  <span class="badge badge-success">Ativo</span>
                <% } else { %>
                  <span class="badge badge-warning">Inativo</span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/tenant/clients/<%= client.id %>/edit" class="btn btn-sm btn-secondary" title="Editar">
                  <i class="icon-edit"></i>
                </a>
                <form action="/tenant/clients/<%= client.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este cliente?');">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn btn-sm btn-danger" title="Excluir">
                    <i class="icon-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
