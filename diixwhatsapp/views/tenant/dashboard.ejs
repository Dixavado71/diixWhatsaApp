<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head', { title: 'Dashboard da Loja' }) %>
</head>
<body class="tenant-dashboard">
  <%- include('../partials/navbar', { user: user, area: 'tenant' }) %>
  
  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar', { area: 'tenant' }) %>
      
      <main class="col-md-10 ms-sm-auto col-lg-12 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2">Dashboard - <%= tenant.name %></h1>
        </div>
        
        <%- include('../partials/flash') %>
        
        <!-- Stats Cards -->
        <div class="row mb-4">
          <div class="col-md-2">
            <div class="card stats-card bg-primary text-white">
              <div class="card-body text-center">
                <h5 class="card-title">Produtos</h5>
                <h2 class="stats-number"><%= stats.products || 0 %></h2>
              </div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="card stats-card bg-success text-white">
              <div class="card-body text-center">
                <h5 class="card-title">Clientes</h5>
                <h2 class="stats-number"><%= stats.clients || 0 %></h2>
              </div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="card stats-card bg-info text-white">
              <div class="card-body text-center">
                <h5 class="card-title">Serviços</h5>
                <h2 class="stats-number"><%= stats.services || 0 %></h2>
              </div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="card stats-card bg-warning text-white">
              <div class="card-body text-center">
                <h5 class="card-title">Promoções</h5>
                <h2 class="stats-number"><%= stats.promotions || 0 %></h2>
              </div>
            </div>
          </div>
          <div class="col-md-2">
            <div class="card stats-card bg-secondary text-white">
              <div class="card-body text-center">
                <h5 class="card-title">Usuários</h5>
                <h2 class="stats-number"><%= stats.users || 0 %></h2>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="row mb-4">
          <div class="col-md-12">
            <div class="card">
              <div class="card-header">
                <h5 class="mb-0">Acesso Rápido</h5>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-3 mb-3">
                    <a href="/tenant/products" class="btn btn-outline-primary w-100 py-3">
                      <i class="bi bi-box"></i> Gerenciar Produtos
                    </a>
                  </div>
                  <div class="col-md-3 mb-3">
                    <a href="/tenant/clients" class="btn btn-outline-success w-100 py-3">
                      <i class="bi bi-people"></i> Gerenciar Clientes
                    </a>
                  </div>
                  <div class="col-md-3 mb-3">
                    <a href="/tenant/services" class="btn btn-outline-info w-100 py-3">
                      <i class="bi bi-clock"></i> Gerenciar Serviços
                    </a>
                  </div>
                  <div class="col-md-3 mb-3">
                    <a href="/tenant/promotions" class="btn btn-outline-warning w-100 py-3">
                      <i class="bi bi-tag"></i> Gerenciar Promoções
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Tenant Info -->
        <div class="row">
          <div class="col-md-6">
            <div class="card">
              <div class="card-header">
                <h5 class="mb-0">Informações da Loja</h5>
              </div>
              <div class="card-body">
                <table class="table table-sm">
                  <tr>
                    <th width="40%">Nome:</th>
                    <td><%= tenant.name %></td>
                  </tr>
                  <tr>
                    <th>Email:</th>
                    <td><%= tenant.email || 'Não informado' %></td>
                  </tr>
                  <tr>
                    <th>Telefone:</th>
                    <td><%= tenant.phone || 'Não informado' %></td>
                  </tr>
                  <tr>
                    <th>Status:</th>
                    <td>
                      <% if (tenant.active) { %>
                        <span class="badge bg-success">Ativa</span>
                      <% } else { %>
                        <span class="badge bg-danger">Inativa</span>
                      <% } %>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
          
          <div class="col-md-6">
            <div class="card">
              <div class="card-header">
                <h5 class="mb-0">Último Acesso</h5>
              </div>
              <div class="card-body">
                <p class="mb-2"><strong>Usuário:</strong> <%= user.username %></p>
                <p class="mb-2"><strong>Role:</strong> 
                  <% if (user.role === 'TENANT_ADMIN') { %>
                    <span class="badge bg-primary">TENANT_ADMIN</span>
                  <% } else { %>
                    <span class="badge bg-secondary">TENANT_USER</span>
                  <% } %>
                </p>
                <% if (user.lastLoginAt) { %>
                  <p class="mb-0"><strong>Último Login:</strong> <%= new Date(user.lastLoginAt).toLocaleString('pt-BR') %></p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
  
  <%- include('../partials/footer') %>
</body>
</html>
