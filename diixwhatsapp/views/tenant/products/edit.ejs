<%- include('../../layouts/main.ejs', { title: 'Editar Produto', user: locals.user, activeSection: 'products' }) -%>

<div class="page-header">
    <div>
        <h1><i class="icon-edit"></i> Editar Produto</h1>
        <p>Atualize as informações do produto</p>
    </div>
    <a href="/tenant/products" class="btn btn-secondary">
        <i class="icon-arrow-left"></i> Voltar
    </a>
</div>

<%- include('../../partials/flash.ejs', { messages: locals.messages }) -%>

<div class="card">
    <div class="card-body">
        <form action="/tenant/products/<%= product.id %>" method="POST" enctype="multipart/form-data" class="form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="form-row">
                <div class="form-group col-md-8">
                    <label for="name" class="form-label required">Nome do Produto</label>
                    <input type="text" id="name" name="name" class="form-control" required autofocus value="<%= product.name %>">
                </div>
                <div class="form-group col-md-4">
                    <label for="sku" class="form-label">SKU/Código</label>
                    <input type="text" id="sku" name="sku" class="form-control" value="<%= product.sku || '' %>">
                </div>
            </div>

            <div class="form-group">
                <label for="description" class="form-label">Descrição</label>
                <textarea id="description" name="description" class="form-control" rows="4"><%= product.description || '' %></textarea>
            </div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <label for="price" class="form-label required">Preço de Venda (R$)</label>
                    <input type="number" id="price" name="price" class="form-control" step="0.01" min="0" required value="<%= parseFloat(product.price).toFixed(2) %>">
                </div>
                <div class="form-group col-md-3">
                    <label for="costPrice" class="form-label">Preço de Custo (R$)</label>
                    <input type="number" id="costPrice" name="costPrice" class="form-control" step="0.01" min="0" value="<%= parseFloat(product.costPrice || 0).toFixed(2) %>">
                </div>
                <div class="form-group col-md-3">
                    <label for="stock" class="form-label required">Estoque</label>
                    <input type="number" id="stock" name="stock" class="form-control" min="0" required value="<%= product.stock %>">
                </div>
                <div class="form-group col-md-3">
                    <label for="image" class="form-label">URL da Imagem</label>
                    <input type="url" id="image" name="image" class="form-control" value="<%= product.image || '' %>">
                </div>
            </div>

            <div class="form-group">
                <label class="form-checkbox">
                    <input type="checkbox" name="active" <%= product.active ? 'checked' : '' %>>
                    <span class="checkmark"></span>
                    Produto Ativo
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="icon-check"></i> Salvar Alterações
                </button>
                <a href="/tenant/products" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
// Formatação de preço em tempo real
document.getElementById('price')?.addEventListener('blur', function(e) {
    const value = parseFloat(e.target.value);
    if (!isNaN(value)) {
        e.target.value = value.toFixed(2);
    }
});

document.getElementById('costPrice')?.addEventListener('blur', function(e) {
    const value = parseFloat(e.target.value);
    if (!isNaN(value)) {
        e.target.value = value.toFixed(2);
    }
});
</script>

<%- include('../../partials/footer.ejs') -%>
