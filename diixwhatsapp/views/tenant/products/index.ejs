<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head', { title: 'Produtos' }) %>
</head>
<body class="tenant-products">
  <%- include('../../partials/navbar', { user: user, area: 'tenant' }) %>
  
  <div class="container-fluid">
    <div class="row">
      <%- include('../../partials/sidebar', { area: 'tenant' }) %>
      
      <main class="col-md-10 ms-sm-auto col-lg-12 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2">Produtos</h1>
          <a href="/tenant/products/new" class="btn btn-primary">Novo Produto</a>
        </div>
        
        <%- include('../../partials/flash') %>
        
        <div class="card">
          <div class="card-body">
            <% if (products && products.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead>
                    <tr>
                      <th>Nome</th>
                      <th>SKU</th>
                      <th>Preço</th>
                      <th>Custo</th>
                      <th>Estoque</th>
                      <th>Status</th>
                      <th>Ações</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% products.forEach(product => { %>
                      <tr>
                        <td><strong><%= product.name %></strong></td>
                        <td><code><%= product.sku || '-' %></code></td>
                        <td>R$ <%= (product.price / 100).toFixed(2) %></td>
                        <td>R$ <%= product.costPrice ? (product.costPrice / 100).toFixed(2) : '-' %></td>
                        <td><%= product.stock || 0 %></td>
                        <td>
                          <% if (product.active) { %>
                            <span class="badge bg-success">Ativo</span>
                          <% } else { %>
                            <span class="badge bg-danger">Inativo</span>
                          <% } %>
                        </td>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <a href="/tenant/products/<%= product.id %>/edit" class="btn btn-outline-secondary">Editar</a>
                            <form action="/tenant/products/<%= product.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <button type="submit" class="btn btn-outline-danger">Excluir</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <p class="text-muted text-center">Nenhum produto cadastrado.</p>
            <% } %>
          </div>
        </div>
      </main>
    </div>
  </div>
  
  <%- include('../../partials/footer') %>
</body>
</html>
