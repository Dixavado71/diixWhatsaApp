<%- include('../partials/head', { title: title }) %>

<div class="dashboard-container">
  <div class="page-header">
    <h1><i class="icon-promotions"></i> Promoções</h1>
    <a href="/tenant/promotions/new" class="btn btn-primary">
      <i class="icon-plus"></i> Nova Promoção
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (promotions.length === 0) { %>
    <div class="empty-state">
      <i class="icon-inbox"></i>
      <p>Nenhuma promoção cadastrada</p>
      <a href="/tenant/promotions/new" class="btn btn-secondary">Cadastrar primeira promoção</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Tipo</th>
            <th>Desconto</th>
            <th>Início</th>
            <th>Fim</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% promotions.forEach(promotion => { %>
            <tr>
              <td><strong><%= promotion.name %></strong></td>
              <td>
                <% if (promotion.discountType === 'PERCENTAGE') { %>
                  <span class="badge badge-info">Porcentagem</span>
                <% } else { %>
                  <span class="badge badge-info">Valor Fixo</span>
                <% } %>
              </td>
              <td>
                <% if (promotion.discountType === 'PERCENTAGE') { %>
                  <%= promotion.discountValue %>%
                <% } else { %>
                  R$ <%= parseFloat(promotion.discountValue).toFixed(2).replace('.', ',') %>
                <% } %>
              </td>
              <td>
                <% if (promotion.startDate) { %>
                  <%= new Date(promotion.startDate).toLocaleDateString('pt-BR') %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (promotion.endDate) { %>
                  <%= new Date(promotion.endDate).toLocaleDateString('pt-BR') %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (promotion.active) { %>
                  <span class="badge badge-success">Ativa</span>
                <% } else { %>
                  <span class="badge badge-warning">Inativa</span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/tenant/promotions/<%= promotion.id %>/edit" class="btn btn-sm btn-secondary" title="Editar">
                  <i class="icon-edit"></i>
                </a>
                <form action="/tenant/promotions/<%= promotion.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta promoção?');">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn btn-sm btn-danger" title="Excluir">
                    <i class="icon-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
