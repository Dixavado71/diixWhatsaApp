<%- include('../../partials/head', { title: title }) %>

<div class="dashboard-container">
  <div class="page-header">
    <h1><i class="icon-promotions"></i> Editar Promoção</h1>
    <a href="/tenant/promotions" class="btn btn-secondary">
      <i class="icon-arrow-left"></i> Voltar
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (!promotion) { %>
    <div class="alert alert-error">
      Promoção não encontrada
    </div>
  <% } else { %>
    <form action="/tenant/promotions/<%= promotion.id %>" method="POST" class="form-card">
      <%- include('../../partials/csrf') %>
      
      <div class="form-row">
        <div class="form-group">
          <label for="name">Nome *</label>
          <input type="text" id="name" name="name" class="form-control" 
                 value="<%= promotion.name %>" required>
        </div>
        
        <div class="form-group">
          <label for="discountType">Tipo de Desconto *</label>
          <select id="discountType" name="discountType" class="form-control" required>
            <option value="PERCENTAGE" <%= promotion.discountType === 'PERCENTAGE' ? 'selected' : '' %>>Porcentagem (%)</option>
            <option value="FIXED" <%= promotion.discountType === 'FIXED' ? 'selected' : '' %>>Valor Fixo (R$)</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="discountValue">Valor do Desconto *</label>
          <input type="number" step="0.01" id="discountValue" name="discountValue" class="form-control" 
                 value="<%= promotion.discountValue %>" required>
          <small class="help-text">
            <%= promotion.discountType === 'PERCENTAGE' ? 'Informe a porcentagem de desconto' : 'Informe o valor fixo em reais' %>
          </small>
        </div>
        
        <div class="form-group">
          <label class="checkbox-label" style="margin-top: 32px;">
            <input type="checkbox" name="active" value="true" 
                   <%= promotion.active ? 'checked' : '' %>>
            Promoção ativa
          </label>
        </div>
      </div>

      <div class="form-group">
        <label for="description">Descrição</label>
        <textarea id="description" name="description" class="form-control" rows="3"><%= promotion.description || '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="startDate">Data de Início</label>
          <input type="date" id="startDate" name="startDate" class="form-control" 
                 value="<%= promotion.startDate ? new Date(promotion.startDate).toISOString().split('T')[0] : '' %>">
        </div>
        
        <div class="form-group">
          <label for="endDate">Data de Fim</label>
          <input type="date" id="endDate" name="endDate" class="form-control" 
                 value="<%= promotion.endDate ? new Date(promotion.endDate).toISOString().split('T')[0] : '' %>">
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <i class="icon-save"></i> Atualizar Promoção
        </button>
        <a href="/tenant/promotions" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  <% } %>
</div>

<script>
  document.getElementById('discountType').addEventListener('change', function() {
    const valueInput = document.getElementById('discountValue');
    const helpText = valueInput.nextElementSibling;
    
    if (this.value === 'PERCENTAGE') {
      helpText.textContent = 'Informe a porcentagem de desconto (ex: 10 para 10%)';
    } else {
      helpText.textContent = 'Informe o valor fixo em reais (ex: 5.00 para R$ 5,00)';
    }
  });
</script>

<%- include('../../partials/footer') %>
