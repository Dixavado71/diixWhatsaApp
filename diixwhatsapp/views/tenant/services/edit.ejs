<%- include('../../partials/head', { title: title }) %>

<div class="dashboard-container">
  <div class="page-header">
    <h1><i class="icon-services"></i> Editar Serviço</h1>
    <a href="/tenant/services" class="btn btn-secondary">
      <i class="icon-arrow-left"></i> Voltar
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (!service) { %>
    <div class="alert alert-error">
      Serviço não encontrado
    </div>
  <% } else { %>
    <form action="/tenant/services/<%= service.id %>" method="POST" class="form-card">
      <%- include('../../partials/csrf') %>
      
      <div class="form-row">
        <div class="form-group">
          <label for="name">Nome *</label>
          <input type="text" id="name" name="name" class="form-control" 
                 value="<%= service.name %>" required>
        </div>
        
        <div class="form-group">
          <label for="price">Preço (R$)</label>
          <input type="number" step="0.01" id="price" name="price" class="form-control" 
                 value="<%= service.price || '' %>">
        </div>
      </div>

      <div class="form-group">
        <label for="description">Descrição</label>
        <textarea id="description" name="description" class="form-control" rows="3"><%= service.description || '' %></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="duration">Duração (minutos)</label>
          <input type="number" id="duration" name="duration" class="form-control" 
                 value="<%= service.duration || '' %>">
        </div>
        
        <div class="form-group">
          <label class="checkbox-label" style="margin-top: 32px;">
            <input type="checkbox" name="active" value="true" 
                   <%= service.active ? 'checked' : '' %>>
            Serviço ativo
          </label>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          <i class="icon-save"></i> Atualizar Serviço
        </button>
        <a href="/tenant/services" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  <% } %>
</div>

<%- include('../../partials/footer') %>
