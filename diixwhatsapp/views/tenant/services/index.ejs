<%- include('../partials/head', { title: title }) %>

<div class="dashboard-container">
  <div class="page-header">
    <h1><i class="icon-services"></i> Serviços</h1>
    <a href="/tenant/services/new" class="btn btn-primary">
      <i class="icon-plus"></i> Novo Serviço
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
      <%= error %>
    </div>
  <% } %>

  <% if (services.length === 0) { %>
    <div class="empty-state">
      <i class="icon-inbox"></i>
      <p>Nenhum serviço cadastrado</p>
      <a href="/tenant/services/new" class="btn btn-secondary">Cadastrar primeiro serviço</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Preço</th>
            <th>Duração</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% services.forEach(service => { %>
            <tr>
              <td><strong><%= service.name %></strong></td>
              <td>
                <% if (service.description) { %>
                  <%= service.description.substring(0, 50) %><%= service.description.length > 50 ? '...' : '' %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (service.price) { %>
                  R$ <%= parseFloat(service.price).toFixed(2).replace('.', ',') %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (service.duration) { %>
                  <%= service.duration %> min
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (service.active) { %>
                  <span class="badge badge-success">Ativo</span>
                <% } else { %>
                  <span class="badge badge-warning">Inativo</span>
                <% } %>
              </td>
              <td class="actions">
                <a href="/tenant/services/<%= service.id %>/edit" class="btn btn-sm btn-secondary" title="Editar">
                  <i class="icon-edit"></i>
                </a>
                <form action="/tenant/services/<%= service.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este serviço?');">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn btn-sm btn-danger" title="Excluir">
                    <i class="icon-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
