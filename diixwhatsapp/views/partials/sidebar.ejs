<!-- Sidebar Premium -->
<aside class="fixed left-0 top-16 h-screen w-64 glass dark:glass-dark shadow-xl z-40 transform transition-transform duration-300 ease-in-out no-print"
         x-data="{ open: true }"
         :class="open ? 'translate-x-0' : '-translate-x-full'"
         class="lg:translate-x-0">
  <div class="flex flex-col h-full p-4">
    <!-- User Info -->
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="mb-6 pb-4 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-accent-500 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-glow">
            <%= (user.name || user.username).charAt(0).toUpperCase() %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= user.name || user.username %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400 capitalize"><%= user.role.replace('_', ' ') %></p>
          </div>
        </div>
      </div>
    <% } %>
    
    <!-- Navigation -->
    <nav class="flex-1 space-y-2 overflow-y-auto">
      <% if (typeof user !== 'undefined' && user && user.role === 'MASTER') { %>
        <a href="/admin/dashboard" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-squares-four text-xl"></i>
          <span class="font-medium">Dashboard</span>
        </a>
        
        <a href="/admin/tenants" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'tenants' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-storefront text-xl"></i>
          <span class="font-medium">Lojas</span>
        </a>
        
        <a href="/admin/users" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-users text-xl"></i>
          <span class="font-medium">Usuários</span>
        </a>
      <% } else if (typeof user !== 'undefined' && user && (user.role === 'TENANT_ADMIN' || user.role === 'TENANT_USER')) { %>
        <a href="/tenant/dashboard" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-squares-four text-xl"></i>
          <span class="font-medium">Dashboard</span>
        </a>
        
        <a href="/tenant/products" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'products' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-package text-xl"></i>
          <span class="font-medium">Produtos</span>
        </a>
        
        <a href="/tenant/clients" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'clients' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-users text-xl"></i>
          <span class="font-medium">Clientes</span>
        </a>
        
        <a href="/tenant/services" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'services' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-briefcase text-xl"></i>
          <span class="font-medium">Serviços</span>
        </a>
        
        <a href="/tenant/promotions" 
           class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'promotions' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
          <i class="ph ph-tag text-xl"></i>
          <span class="font-medium">Promoções</span>
        </a>
        
        <% if (user.role === 'TENANT_ADMIN') { %>
          <a href="/tenant/users" 
             class="flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-300 <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'bg-diix-gradient text-white shadow-glow' : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800' %>">
            <i class="ph ph-user-gear text-xl"></i>
            <span class="font-medium">Usuários</span>
          </a>
        <% } %>
      <% } %>
    </nav>
    
    <!-- Footer -->
    <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
      <p class="text-xs text-center text-gray-500 dark:text-gray-400">
        DiixWhatsApp v1.0<br>
        © 2024 Diix Solutions
      </p>
    </div>
  </div>
</aside>
